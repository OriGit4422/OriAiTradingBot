DATABASE_URL=postgresql://user:password@localhost:5432/tradingbot

# Required — no defaults. Login is rejected until both are set.
AUTH_USERNAME=
AUTH_PASSWORD=
# Secret used to sign session cookies. Falls back to AUTH_PASSWORD if unset,
# but a dedicated random value is recommended.
SESSION_SECRET=

# ─── AI spend cap ────────────────────────────────────────────────────────────
# Hard daily ceiling in USD, applied PER PROVIDER and reset at UTC midnight.
# Defaults to 0.05. Anything unparseable or non-positive is ignored with a
# warning and the default is used — the cap always fails closed.
# Within the cap, tiers are cut off at different points: cosmetic calls stop at
# 35%, normal at 75%, and the AI veto on a tradeable signal runs to 100%.
AI_DAILY_BUDGET_USD=0.05

# ─── Live trading ────────────────────────────────────────────────────────────
# Both this AND live=true in the call are required before any real order is
# placed. Testnet/sandbox is the default on every exchange client.
LIVE_TRADING_CONFIRMED=false
